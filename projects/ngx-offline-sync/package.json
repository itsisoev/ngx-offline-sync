    "email": "isoev9733@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsisoev/ngx-offline-sync.git"
  },
  "homepage": "https://github.com/itsisoev/ngx-offline-sync#readme",
