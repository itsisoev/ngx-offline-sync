  "scripts": {
    "build": "tsc -p tsconfig.schematics.json",
    "postbuild": "copyfiles -u 1 \"schematics/package.json\" \"schematics/collection.json\" \"schematics/ng-add/schema.json\" \"schematics/ng-add/files/**/*\" ../../dist/ngx-offline-sync/schematics"
